# Rust build products and generated release artifacts
/target/
/dist/
/release/

# Generated Flatpak build outputs (also documented in flatpak/.gitignore)
/flatpak/build-dir/
/flatpak/.flatpak-builder/
/flatpak/cargo-config.toml
/flatpak/cargo-vendor/
/flatpak/repo/
/flatpak/*.flatpak
/flatpak/shared-modules/

# Local/editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local backups, logs, and compiled binaries
*.tmp
*.bak
*.log
*.exe
*.dll
*.pdb

# The Go animation helper is embedded into the EXE and committed on purpose (see go_animations/UPSTREAM.md).
!/go_animations/gxoled-animations.exe

# Python byte-code of the helper scripts in tools/
__pycache__/
*.pyc
